{
  "pipelineVersion": 7,
  "nativeGuard": {
    "enabled": true,
    "sampleMode": "hires",
    "sensorTimeoutMs": 1500,
    "stageWatchdogMinutes": 1,
    "profiles": [
      {"id":"desktop","enabled":true,"luxCenter":100,"luxTolerance":5,"stableDurationMs":100,"hysteresisLux":2,"calibrationCue":8,"lightCooldownMs":0},
      {"id":"login-or-dc","enabled":true,"luxCenter":200,"luxTolerance":5,"stableDurationMs":100,"hysteresisLux":2,"calibrationCue":7,"lightCooldownMs":0},
      {"id":"character-dashboard","enabled":true,"luxCenter":300,"luxTolerance":5,"stableDurationMs":100,"hysteresisLux":2,"calibrationCue":6,"lightCooldownMs":0},
      {"id":"entering-game-loading","enabled":true,"luxCenter":400,"luxTolerance":5,"stableDurationMs":100,"hysteresisLux":2,"calibrationCue":5,"lightCooldownMs":0},
      {"id":"game","enabled":true,"luxCenter":500,"luxTolerance":5,"stableDurationMs":100,"hysteresisLux":2,"calibrationCue":4,"lightCooldownMs":0},
      {"id":"targeted","enabled":true,"luxCenter":600,"luxTolerance":5,"stableDurationMs":100,"hysteresisLux":2,"calibrationCue":3,"lightCooldownMs":0},
      {"id":"whisper","enabled":true,"luxCenter":700,"luxTolerance":5,"stableDurationMs":100,"hysteresisLux":2,"calibrationCue":2,"lightCooldownMs":5000},
      {"id":"whisper-repeat","enabled":true,"luxCenter":800,"luxTolerance":5,"stableDurationMs":100,"hysteresisLux":2,"calibrationCue":1,"lightCooldownMs":3600000}
    ]
  },
  "nativeCycle": {
    "enabled": true,
    "autoResume": true,
    "runMinSeconds": 1,
    "runMaxSeconds": 1,
    "maxRestarts": 5,
    "usbStableMs": 2000
  },
  "pipelines": {
    "Desktop": [{"Type":"delay","Props":{"minMs":1,"maxMs":1},"Children":[],"Delay":0,"IsDisabled":false}],
    "Restart": [{"Type":"delay","Props":{"minMs":1,"maxMs":1},"Children":[],"Delay":0,"IsDisabled":false}],
    "Startup": [{"Type":"delay","Props":{"minMs":1,"maxMs":1},"Children":[],"Delay":0,"IsDisabled":false}],
    "LoginOrDc": [{"Type":"delay","Props":{"minMs":1,"maxMs":1},"Children":[],"Delay":0,"IsDisabled":false}],
    "Dc": [{"Type":"keystroke","Props":{"key":"ESC","holdMin":1,"holdMax":1},"Children":[],"Delay":0,"IsDisabled":false}],
    "CharacterDashboard": [{"Type":"delay","Props":{"minMs":1,"maxMs":1},"Children":[],"Delay":0,"IsDisabled":false}],
    "EnteringGameLoading": [{"Type":"delay","Props":{"minMs":1,"maxMs":1},"Children":[],"Delay":0,"IsDisabled":false}],
    "Game": [
      {"Type":"gotoLabel","Props":{"label":"after"},"Children":[],"Delay":0,"IsDisabled":false},
      {"Type":"keystroke","Props":{"key":"X","holdMin":1,"holdMax":1},"Children":[],"Delay":0,"IsDisabled":false},
      {"Type":"label","Props":{"label":"after"},"Children":[],"Delay":0,"IsDisabled":false},
      {"Type":"delay","Props":{"minMs":1,"maxMs":1},"Children":[],"Delay":0,"IsDisabled":false}
    ],
    "Targeted": [{"Type":"keystroke","Props":{"key":"E","holdMin":1,"holdMax":1},"Children":[],"Delay":0,"IsDisabled":false}],
    "Whisper": [{"Type":"typeText","Props":{"text":"guard","hmin":1,"hmax":1},"Children":[],"Delay":0,"IsDisabled":false}],
    "WhisperRepeat": [{"Type":"typeText","Props":{"text":"repeat","hmin":1,"hmax":1},"Children":[],"Delay":0,"IsDisabled":false}]
  }
}
